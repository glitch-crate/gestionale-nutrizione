# Copia questo file in .env.local (già escluso da Git) e inserisci
# i valori reali. Se usi Claude Code, la procedura di installazione
# (supabase/README.md) lo compila per te.

# --- Supabase: Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-tua-chiave-pubblica-anon-o-publishable

# Chiave segreta "service_role": solo lato server, MAI nel codice o in chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend): promemoria del giorno prima, conferme di prenotazione,
# avvisi allo studio. Senza RESEND_API_KEY il gestionale funziona ma non invia email.
RESEND_API_KEY=
# Mittente da un dominio verificato su Resend, es. "Studio Rossi <promemoria@studiorossi.it>"
RESEND_FROM=
# Almeno 16 caratteri casuali (vedi supabase/README.md per generarlo).
CRON_SECRET=
